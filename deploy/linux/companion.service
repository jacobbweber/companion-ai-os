[Unit]
Description=Companion AI OS — Local-First Web Studio & Background Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=companion
Group=companion
WorkingDirectory=/opt/companion
EnvironmentFile=-/var/lib/companion/.env
Environment="PYTHONUNBUFFERED=1"
Environment="COMPANION_DATA_DIR=/var/lib/companion"
Environment="COMPANION_SELF_DEV_LOCKED=1"
ExecStart=/usr/bin/python3 /opt/companion/harness.py --data-dir /var/lib/companion --locked --web --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/companion

[Install]
WantedBy=multi-user.target
