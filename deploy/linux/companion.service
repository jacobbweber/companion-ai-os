[Unit]
Description=Companion AI OS — Local-First Web Studio & Background Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=companion
Group=companion
WorkingDirectory=/opt/companion
EnvironmentFile=-/var/lib/companion/.env
Environment="PYTHONUNBUFFERED=1"
Environment="COMPANION_DATA_DIR=/var/lib/companion"
Environment="COMPANION_IMMUTABLE_APP=1"
ExecStart=/usr/bin/python3 /opt/companion/harness.py --data-dir /var/lib/companion --immutable --web --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/companion

[Install]
WantedBy=multi-user.target
