{
  "name": "release-check",
  "description": "Zero-token deterministic GitHub release readiness DAG (.gitignore privacy shield, SDD sync, and 7-stage System Doctor).",
  "inputs": {
    "run_tests": "true"
  },
  "nodes": [
    {
      "id": "check_gitignore_shield",
      "type": "tool",
      "tool": "read_file",
      "args": {
        "path": ".gitignore"
      }
    },
    {
      "id": "verify_no_tracked_leaks",
      "type": "tool",
      "tool": "run_python",
      "args": {
        "code": "import subprocess, sys\ntracked = subprocess.check_output(['git', 'ls-files'], text=True).splitlines()\nbad = [f for f in tracked if f in {'.env', 'secrets.env', 'MEMORY.md', 'IDENTITY.md'} or f.startswith(('data/', 'companion-data/', '.companion_backups/')) or f.endswith(('.db', '.sqlite', '.exe'))]\nif bad:\n    print('FAIL: tracked private files:', bad)\n    sys.exit(1)\nprint('PASS: zero tracked private/secret files across', len(tracked), 'files')"
      }
    },
    {
      "id": "verify_specs_and_hygiene",
      "type": "tool",
      "tool": "sdd_manage",
      "args": {
        "action": "verify"
      }
    },
    {
      "id": "run_system_doctor",
      "type": "tool",
      "tool": "system_doctor",
      "args": {
        "run_tests": "{{run_tests}}"
      }
    }
  ],
  "edges": [
    {
      "from": "check_gitignore_shield",
      "to": "verify_no_tracked_leaks",
      "condition": "contains:MEMORY.md"
    },
    {
      "from": "check_gitignore_shield",
      "to": "ABORTED",
      "condition": "always"
    },
    {
      "from": "verify_no_tracked_leaks",
      "to": "verify_specs_and_hygiene",
      "condition": "passed"
    },
    {
      "from": "verify_no_tracked_leaks",
      "to": "ABORTED",
      "condition": "failed"
    },
    {
      "from": "verify_specs_and_hygiene",
      "to": "run_system_doctor",
      "condition": "passed"
    },
    {
      "from": "verify_specs_and_hygiene",
      "to": "ABORTED",
      "condition": "failed"
    },
    {
      "from": "run_system_doctor",
      "to": "COMPLETE",
      "condition": "passed"
    },
    {
      "from": "run_system_doctor",
      "to": "ABORTED",
      "condition": "failed"
    }
  ]
}
