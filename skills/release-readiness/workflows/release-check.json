{
  "name": "release-check",
  "description": "Zero-token deterministic GitHub release readiness DAG (.gitignore privacy shield, SDD sync, and 7-stage System Doctor).",
  "inputs": {
    "run_tests": "true"
  },
  "nodes": [
    {
      "id": "check_gitignore_shield",
      "type": "tool",
      "tool": "read_file",
      "args": {
        "path": ".gitignore"
      }
    },
    {
      "id": "verify_specs_and_hygiene",
      "type": "tool",
      "tool": "sdd_manage",
      "args": {
        "action": "verify"
      }
    },
    {
      "id": "run_system_doctor",
      "type": "tool",
      "tool": "system_doctor",
      "args": {
        "run_tests": "{{run_tests}}"
      }
    }
  ],
  "edges": [
    {
      "from": "check_gitignore_shield",
      "to": "verify_specs_and_hygiene",
      "condition": "contains:MEMORY.md"
    },
    {
      "from": "check_gitignore_shield",
      "to": "ABORTED",
      "condition": "always"
    },
    {
      "from": "verify_specs_and_hygiene",
      "to": "run_system_doctor",
      "condition": "passed"
    },
    {
      "from": "verify_specs_and_hygiene",
      "to": "ABORTED",
      "condition": "failed"
    },
    {
      "from": "run_system_doctor",
      "to": "COMPLETE",
      "condition": "passed"
    },
    {
      "from": "run_system_doctor",
      "to": "ABORTED",
      "condition": "failed"
    }
  ]
}
