{
  "name": "ooda-diagnose",
  "description": "Execute the OODA Loop (Observe on fast tier -> Orient & Decide on reasoning tier -> Verify via System Doctor).",
  "inputs": {
    "issue": "Diagnose and repair any failing System Doctor or unit test checks."
  },
  "nodes": [
    {
      "id": "observe_signals",
      "type": "tool",
      "tier": "fast",
      "tool": "system_doctor",
      "args": {
        "run_tests": true
      }
    },
    {
      "id": "orient_and_decide",
      "type": "subagent",
      "tier": "reasoning",
      "skill": "ooda-troubleshooting",
      "max_iters": 6,
      "prompt": "Apply the OODA Loop (Orient -> Decide -> Act) for issue: {{inputs.issue}}\n\nObserved System Doctor Signals:\n{{steps.observe_signals.output}}"
    },
    {
      "id": "verify_gate",
      "type": "tool",
      "tier": "fast",
      "tool": "system_doctor",
      "args": {
        "run_tests": true
      }
    }
  ],
  "edges": [
    {
      "from": "observe_signals",
      "to": "COMPLETE",
      "condition": "passed"
    },
    {
      "from": "observe_signals",
      "to": "orient_and_decide",
      "condition": "failed"
    },
    {
      "from": "orient_and_decide",
      "to": "verify_gate",
      "condition": "always"
    },
    {
      "from": "verify_gate",
      "to": "COMPLETE",
      "condition": "passed"
    },
    {
      "from": "verify_gate",
      "to": "ABORTED",
      "condition": "failed"
    }
  ]
}
