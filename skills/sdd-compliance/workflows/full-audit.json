{
  "name": "full-audit",
  "description": "Deterministic SDD, AST hygiene, and System Doctor audit pipeline with conditional subagent repair.",
  "inputs": {
    "run_tests": "true"
  },
  "nodes": [
    {
      "id": "verify_sdd_and_hygiene",
      "type": "tool",
      "tier": "fast",
      "tool": "sdd_manage",
      "args": {
        "action": "verify"
      }
    },
    {
      "id": "run_doctor_gate",
      "type": "tool",
      "tier": "fast",
      "tool": "system_doctor",
      "args": {
        "run_tests": "{{run_tests}}"
      }
    },
    {
      "id": "subagent_repair",
      "type": "subagent",
      "tier": "reasoning",
      "skill": "sdd-compliance",
      "max_iters": 6,
      "prompt": "Diagnose and repair the following SDD/hygiene or System Doctor failure:\n{{last_output}}"
    },
    {
      "id": "reverify_after_repair",
      "type": "tool",
      "tier": "fast",
      "tool": "system_doctor",
      "args": {
        "run_tests": "{{run_tests}}"
      }
    }
  ],
  "edges": [
    {
      "from": "verify_sdd_and_hygiene",
      "to": "run_doctor_gate",
      "condition": "passed"
    },
    {
      "from": "verify_sdd_and_hygiene",
      "to": "subagent_repair",
      "condition": "failed"
    },
    {
      "from": "run_doctor_gate",
      "to": "COMPLETE",
      "condition": "passed"
    },
    {
      "from": "run_doctor_gate",
      "to": "subagent_repair",
      "condition": "failed"
    },
    {
      "from": "subagent_repair",
      "to": "reverify_after_repair",
      "condition": "passed"
    },
    {
      "from": "subagent_repair",
      "to": "ABORTED",
      "condition": "failed"
    },
    {
      "from": "reverify_after_repair",
      "to": "COMPLETE",
      "condition": "passed"
    },
    {
      "from": "reverify_after_repair",
      "to": "ABORTED",
      "condition": "failed"
    }
  ]
}
