# Companion AI OS Configuration Template
# Copy this file to .env and adjust as needed.

# Local or Remote Default LLM Endpoint (defaults to local Ollama; hot-configurable via System -> Models, Tiers & Context or `/providers`)
COMPANION_BASE_URL=http://127.0.0.1:11434
COMPANION_MODEL=qwen2.5:7b
# Wire Dialect: openai_compat | anthropic_messages | gemini_native
COMPANION_DIALECT=openai_compat
# Outbound Privacy Lock: local_only (LAN/loopback only) | hybrid | cloud_allowed
COMPANION_PRIVACY_MODE=local_only
COMPANION_API_KEY=

# Optional Purpose-Routed & Multi-Modal Tier Overrides (if blank, inherit Global Default above)
# Fast Execution Tier (interactive chat, discovery, lightweight tool calls; default temp=0.15)
COMPANION_FAST_BASE_URL=
COMPANION_FAST_MODEL=
COMPANION_FAST_API_KEY=
COMPANION_FAST_CONTEXT_WINDOW=
COMPANION_FAST_TEMP=
COMPANION_FAST_MAX_TOKENS=
# Dedicated Coding Specialist Tier (IMPLEMENT phase routing when set; default temp=0.15)
COMPANION_CODING_BASE_URL=
COMPANION_CODING_MODEL=
COMPANION_CODING_API_KEY=
COMPANION_CODING_CONTEXT_WINDOW=
COMPANION_CODING_TEMP=
COMPANION_CODING_MAX_TOKENS=
# Deep Reasoning Tier (architecture, OODA orientation, tradeoff analysis, planning; default temp=0.60)
COMPANION_REASONING_BASE_URL=
COMPANION_REASONING_MODEL=
COMPANION_REASONING_API_KEY=
COMPANION_REASONING_CONTEXT_WINDOW=262144
COMPANION_REASONING_TEMP=
COMPANION_REASONING_MAX_TOKENS=
# Multi-Modal Tiers (audio, image, video)
COMPANION_AUDIO_BASE_URL=
COMPANION_AUDIO_MODEL=
COMPANION_AUDIO_API_KEY=
COMPANION_AUDIO_CONTEXT_WINDOW=
COMPANION_IMAGE_BASE_URL=
COMPANION_IMAGE_MODEL=
COMPANION_IMAGE_API_KEY=
COMPANION_IMAGE_CONTEXT_WINDOW=
COMPANION_VIDEO_BASE_URL=
COMPANION_VIDEO_MODEL=
COMPANION_VIDEO_API_KEY=
COMPANION_VIDEO_CONTEXT_WINDOW=

# Project & Agent Execution Settings (auto-detected from repository directory when blank)
# COMPANION_ROOT=
# Optional separate directory for user runtime data (DB, MEMORY.md, IDENTITY.md, Wiki, secrets.env, backups, user skills; defaults to ./data)
# COMPANION_DATA_DIR=
# Optional parent directory for greenfield Git repositories (defaults to ~/projects on packaged Linux runtime or parent of COMPANION_ROOT in local dev)
# COMPANION_PROJECTS_DIR=
COMPANION_MAX_ITERS=25
COMPANION_TEMP=0.2
COMPANION_MAX_TOKENS=4096
COMPANION_SHELL_TIMEOUT=60
COMPANION_HTTP_TIMEOUT=900
# Conservative timeout (seconds) when swapping Docker/VRAM models on a single-GPU gateway
COMPANION_SWAP_TIMEOUT=1800
# Automatically create a non-destructive local Git save-point when autonomous goals pass verification
COMPANION_AUTO_GIT_COMMIT=true
# Default bind host & port when launching the Web UI (`python harness.py --web`)
# Use 127.0.0.1 for local loopback; set COMPANION_WEB_TOKEN when binding 0.0.0.0 or a LAN/Tailnet IP.
COMPANION_WEB_HOST=127.0.0.1
COMPANION_WEB_PORT=8000
# COMPANION_WEB_TOKEN=

# Output & Adaptive Context Window Compaction Limits (262k Model Window)
COMPANION_OUT_LIMIT=8000
COMPANION_SEARCH_LIMIT=200
COMPANION_CONTEXT_WINDOW=262144
COMPANION_COMPACT_TRIGGER_PCT=75
COMPANION_COMPACT_TARGET_PCT=35
COMPANION_KEEP_RECENT_MESSAGES=16
COMPANION_MAX_BACKUPS=10

# Installed-App Immutability & Background Autonomy (ADR-019 / ADR-020)
# Companion's installed app/ runtime is permanently immutable; develop repos via Board Projects (`workspace_path`).
COMPANION_IMMUTABLE_APP=1
COMPANION_IDLE_MINUTES=120
COMPANION_HOBBY_COOLDOWN_MINUTES=30
COMPANION_HOBBY_MAX_ITERS=20

# Code Simplicity & Anti-Bloat Ceilings
COMPANION_MAX_MODULE_LINES=700
COMPANION_MAX_FUNCTION_LINES=100

# Optional Pre-Deployment Identity & Soul Bootstrap (if blank, prompted on first boot)
COMPANION_NAME=
COMPANION_SOUL=
COMPANION_USER_NAME=
COMPANION_USER_PROFILE=
